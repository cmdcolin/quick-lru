{
  "name": "@jbrowse/quick-lru",
  "version": "8.0.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Simple “Least Recently Used” (LRU) cache, forked from sindresorhus/quick-lru for CJS",
  "license": "MIT",
  "repository": "cmdcolin/quick-lru",
  "author": {
    "name": "Sindre Sorhus",
    "email": "sindresorhus@gmail.com",
    "url": "https://sindresorhus.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "import": "./esm/index.js",
    "require": "./dist/index.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest",
    "clean": "rimraf dist esm",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json",
    "prebuild": "pnpm clean",
    "build:esm": "tsc --outDir esm",
    "build:es5": "tsc --module commonjs --moduleResolution bundler --outDir dist",
    "postbuild:es5": "echo '{\"type\": \"commonjs\"}' > dist/package.json",
    "build": "pnpm build:esm && pnpm build:es5",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test --run && pnpm build",
    "version": "git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add CHANGELOG.md",
    "postversion": "git push --follow-tags"
  },
  "files": [
    "dist",
    "esm",
    "src"
  ],
  "keywords": [
    "lru",
    "quick",
    "cache",
    "caching",
    "least",
    "recently",
    "used",
    "fast",
    "map",
    "hash",
    "buffer"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.0",
    "git-cliff": "^2.14.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
